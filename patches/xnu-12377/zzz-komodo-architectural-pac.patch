+ * hold NULL without the authentication trapping, and the only field using it is ucred.cr_label, a
+ * MAC label that is routinely NULL. Dropping just the 4th argument would keep the signing and then
+ * trap on those NULLs, so the field is left unsigned instead. */
+#define OS_PTRAUTH_SIGNED_PTR_AUTH_NULL(type)
 #define OS_PTRAUTH_DISCRIMINATOR(str) ptrauth_string_discriminator(str)
 #define __ptrauth_only
 #else //  __has_feature(ptrauth_calls)
