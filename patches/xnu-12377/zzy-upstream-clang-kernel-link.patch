Satisfy the two kinds of link reference an upstream-clang kernel build cannot resolve, and
offer the 16 KiB page granule the iOS arm64e userland is built and signed for.

apple-clang drops C++ static destructors when it compiles kernel code; upstream clang keeps the
ones marked LIBKERN_ALWAYS_DESTROY and registers them with __cxa_atexit, which the kernel does
not have. The PGO buffer writers OSKext declares come from libprofile_rt in the Xcode toolchain,
which the open-source build does not have either. And BCM2837 is a 4 KiB board: XNU_PAGE_SIZE_16K
switches it to the granule VMAPPLE uses, so iOS binaries and signatures need no rewriting.

--- a/libkern/c++/OSKext.cpp
+++ b/libkern/c++/OSKext.cpp
@@ -11114,6 +11114,39 @@
 	const char *NamesEnd);
 }
 
+#if !defined(XNU_PROFILE_RUNTIME) || !XNU_PROFILE_RUNTIME
+/*
+ * Apple links libprofile_rt out of the Xcode toolchain for these two. The open-source build has no
+ * profile runtime, and no kext it loads carries the __llvm_prf_* sections that OSKextGrabPgoDataLocked
+ * needs, so it returns ENOTSUP long before reaching them. Define them to report an empty buffer and a
+ * write failure, which turns a kPgoAll kext request into EIO rather than a link error.
+ */
+extern "C" {
+uint64_t
+__llvm_profile_get_size_for_buffer_internal(
+	const char *DataBegin __unused, const char *DataEnd __unused,
+	const char *CountersBegin __unused, const char *CountersEnd __unused,
+	const char *BitmapBegin __unused, const char *BitmapEnd __unused,
+	const char *NamesBegin __unused, const char *NamesEnd __unused,
+	const char *VTableBegin __unused, const char *VTableEnd __unused,
+	const char *VNamesBegin __unused, const char *VNamesEnd __unused)
+{
+	return 0;
+}
+
+int
+__llvm_profile_write_buffer_internal(
+	char *Buffer __unused,
+	const char *DataBegin __unused, const char *DataEnd __unused,
+	const char *CountersBegin __unused, const char *CountersEnd __unused,
+	const char *BitmapBegin __unused, const char *BitmapEnd __unused,
+	const char *NamesBegin __unused, const char *NamesEnd __unused)
+{
+	return -1;
+}
+}
+#endif /* !XNU_PROFILE_RUNTIME */
+
