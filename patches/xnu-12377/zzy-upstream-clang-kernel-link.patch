--- a/pexpert/pexpert/arm64/BCM2837.h
+++ b/pexpert/pexpert/arm64/BCM2837.h
@@ -19,6 +19,17 @@
 #define __ARM_DEBUG__             7
 #define __ARM64_PMAP_SUBPAGE_L1__ 1
 
+/* 16 KiB pages. iOS arm64e binaries are segment-aligned for a 16 KiB page and their code signatures
+ * hash 16 KiB pages, so a kernel meant to execute them unmodified has to use the same granule; at
+ * 4 KiB every Mach-O and every signature has to be rewritten first. The subpage L1 layouts describe
+ * a 4 KiB translation table, so they go: VMAPPLE drops them for exactly this reason.
+ * XNU_PAGE_SIZE_16K arrives through OTHER_CFLAGS, so it reaches the assembler too -- proc_reg.h
+ * keys the TCR granule and T0SZ/T1SZ off __ARM_16K_PG__ and start.s reads them. */
+#if defined(XNU_PAGE_SIZE_16K) && XNU_PAGE_SIZE_16K
+#define __ARM_16K_PG__            1
+#undef  __ARM64_PMAP_SUBPAGE_L1__
+#endif
