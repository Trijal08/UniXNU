Drive the Samsung-layout UART as the boot console, so this board has a serial log.

Stock xnu-12377 carries the Apple UART driver but no board config defines APPLE_UART, so the
whole block is dead code -- which is also why its register header is no longer included.
BCM2837 only defined PI3_UART, the Raspberry Pi mini-UART, so the kernel was writing console
bytes to registers that do not exist on this SoC and the boot was silent.

The Exynos revision of this UART widened the UFSTAT FIFO counters, so the FIFO accessors read
the register raw and mask it; the boot console node selects the wider layout with the
exynos-fifo-status property. The baud rate needs no patch: xnu-12377 computes the divisor from
/cpus/cpu0/fixed-frequency, and 200 MHz yields ubr_div 107 at sample rate 16, which is exactly
the 0x6b the firmware leaves in the register on this board.

--- a/pexpert/arm/pe_serial.c
+++ b/pexpert/arm/pe_serial.c
@@ -25,6 +25,9 @@
 #include <pexpert/device_tree.h>
 #include <pexpert/arm/consistent_debug.h>
 #include <pexpert/arm64/board_config.h>
+#ifdef APPLE_UART
+#include <pexpert/arm/apple_uart_regs.h>
+#endif
 #include <arm64/proc_reg.h>
 #include <pexpert/arm/protos.h>
 #include <kern/sched_prim.h>
@@ -193,7 +196,15 @@
 static inline void
 serial_poll(void)
 {
-#if __arm64__
+#if __arm64__ && defined(ARM64_BOARD_CONFIG_BCM2837)
+	/*
+	 * UniXNU boards: a WFE here only returns on the next event or interrupt. On the Tensor G4 the
+	 * timebase event stream did not wake the core, so every console byte waited for the next timer
+	 * interrupt and the whole boot crawled at about one character per millisecond. Spin instead:
+	 * the polled transmit path is only used while the console drains.
+	 */
+	__asm__ volatile ("yield" ::: "memory");
+#elif __arm64__
 	if (!uart_hibernation) {
 		__builtin_arm_wfe();
 	}
@@ -220,6 +231,17 @@
 /*****************************************************************************/
 
 #ifdef APPLE_UART
+/*
+ * UFSTAT bit layout. Apple SoCs keep the S3C layout (4-bit FIFO counts, rx full bit 8, tx full bit 9),
+ * which is what apple_uart_regs.h describes. The Exynos revision of the same UART widened the counts:
+ * rx count [7:0] with full bit 8, tx count [23:16] with full bit 24. Reading the register raw and
+ * masking lets one driver serve both; the boot console node selects the Exynos layout with the
+ * "exynos-fifo-status" property. Getting this wrong overruns the transmit FIFO and drops characters.
+ */
+static uint32_t apple_uart_ufstat_rx_mask = 0x10f;  /* rx_fifo_full | rx_fifo_count */
+static uint32_t apple_uart_ufstat_tx_mask = 0x2f0;  /* tx_fifo_full | tx_fifo_count */
+static uint32_t apple_uart_ufstat_tx_full = 0x200;
+
 static void apple_uart_set_baud_rate(uint32_t baud_rate);
 
 /**
@@ -294,8 +316,8 @@
 static inline bool
 apple_uart_fifo_is_empty(void)
 {
-	const ufstat_t ufstat = { .raw = ml_io_read32((uintptr_t) &apple_uart_registers->ufstat) };
-	return !(ufstat.tx_fifo_full || ufstat.tx_fifo_count);
+	const uint32_t ufstat = ml_io_read32((uintptr_t) &apple_uart_registers->ufstat);
+	return (ufstat & apple_uart_ufstat_tx_mask) == 0;
 }
 
 static void
@@ -369,8 +391,8 @@
 MARK_AS_HIBERNATE_TEXT static unsigned int
 apple_uart_transmit_ready(void)
 {
-	ufstat_t ufstat = { .raw = ml_io_read32((uintptr_t) &apple_uart_registers->ufstat) };
-	return !ufstat.tx_fifo_full;
+	const uint32_t ufstat = ml_io_read32((uintptr_t) &apple_uart_registers->ufstat);
+	return (ufstat & apple_uart_ufstat_tx_full) == 0;
 }
 
 MARK_AS_HIBERNATE_TEXT static void
@@ -383,8 +405,8 @@
 static unsigned int
 apple_uart_receive_ready(void)
 {
-	ufstat_t ufstat = { .raw = ml_io_read32((uintptr_t) &apple_uart_registers->ufstat) };
-	return ufstat.rx_fifo_full || ufstat.rx_fifo_count;
+	const uint32_t ufstat = ml_io_read32((uintptr_t) &apple_uart_registers->ufstat);
+	return (ufstat & apple_uart_ufstat_rx_mask) != 0;
 }
 
 static uint8_t
@@ -426,6 +448,16 @@
 	const vm_offset_t soc_base_phys = pe_arm_get_soc_base_phys();
 	apple_uart_registers = (apple_uart_registers_t *)ml_io_map(soc_base_phys + reg->block_offset, reg->block_size);
 
+	// This UART revision reports its FIFO levels with the wider Exynos counts.
+	const void *exynos_fifo_status;
+	unsigned int exynos_fifo_status_size;
+	if (SecureDTGetProperty(devicetree_node, "exynos-fifo-status", &exynos_fifo_status,
+	    &exynos_fifo_status_size) == kSuccess) {
+		apple_uart_ufstat_rx_mask = 0x1ff;
+		apple_uart_ufstat_tx_mask = 0x1ff0000;
+		apple_uart_ufstat_tx_full = 0x1000000;
+	}
+
 	// Check if interrupts are supported.
 	const void *unused;
 	unsigned int unused_size;
--- a/pexpert/pexpert/arm64/board_config.h
+++ b/pexpert/pexpert/arm64/board_config.h
@@ -312,6 +312,7 @@
 #define MAX_CPU_CLUSTERS               1
 
 #define NO_XNU_PLATFORM_ERROR_HANDLER  1
+#define APPLE_UART                     1 /* UniXNU: boards with a Samsung-layout UART use the Apple UART driver */
 #endif  /* ARM64_BOARD_CONFIG_BCM2837 */
 
 #ifdef ARM64_BOARD_CONFIG_VMAPPLE
