@@ -632,6 +632,69 @@ SECURITY_READ_ONLY_LATE(static struct pe_serial_functions) pi3_uart_serial_funct
 
 /*****************************************************************************/
 
+/*
+ * Samsung S3C-compatible UART driven as the firmware left it: the bootloader's
+ * line settings and baud divisor are kept, bytes go out through UTXH while the
+ * FIFO status says there is room. The node is /arm-io/samsung-uart0 with
+ * "reg" relative to the arm-io window (UniXNU boards whose UART the kernel's
+ * own Apple UART driver would otherwise reprogram on a clock guess).
+ */
+static vm_offset_t samsung_uart_base_vaddr = 0;
+
+#define SAMSUNG_UART_UFCON   *((volatile uint32_t *) (samsung_uart_base_vaddr + 0x08))
+#define SAMSUNG_UART_UTRSTAT *((volatile uint32_t *) (samsung_uart_base_vaddr + 0x10))
+#define SAMSUNG_UART_UFSTAT  *((volatile uint32_t *) (samsung_uart_base_vaddr + 0x18))
+#define SAMSUNG_UART_UTXH    *((volatile uint32_t *) (samsung_uart_base_vaddr + 0x20))
+#define SAMSUNG_UART_URXH    *((volatile uint32_t *) (samsung_uart_base_vaddr + 0x24))
+
+static void
+samsung_uart_init(void)
+{
+	/* Nothing: the firmware configured the line and the baud divisor. */
+}
+
+static int
+samsung_uart_tr0(void)
+{
+	if (SAMSUNG_UART_UFCON & 1) {
+		return (SAMSUNG_UART_UFSTAT & (1 << 24)) == 0;
+	}
+	return (SAMSUNG_UART_UTRSTAT & (1 << 1)) != 0;
+}
+
+static void
+samsung_uart_td0(int c)
+{
+	SAMSUNG_UART_UTXH = (uint32_t)(c & 0xff);
+}
+
+static int
+samsung_uart_rr0(void)
+{
+	if (SAMSUNG_UART_UFCON & 1) {
+		return (SAMSUNG_UART_UFSTAT & 0x1ff) != 0;
+	}
+	return (SAMSUNG_UART_UTRSTAT & 1) != 0;
+}
+
+static int
+samsung_uart_rd0(void)
+{
+	return (int)(SAMSUNG_UART_URXH & 0xff);
+}
+
+SECURITY_READ_ONLY_LATE(static struct pe_serial_functions) samsung_uart_serial_functions =
+{
+	.init = samsung_uart_init,
+	.transmit_ready = samsung_uart_tr0,
+	.transmit_data = samsung_uart_td0,
+	.receive_ready = samsung_uart_rr0,
+	.receive_data = samsung_uart_rd0,
+	.device = SERIAL_PI3_UART
+};
+
+/*****************************************************************************/
+
 #ifdef VMAPPLE_UART
 
 static vm_offset_t vmapple_uart0_base_vaddr = 0;
